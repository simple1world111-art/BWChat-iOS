{
  "name": "bwchat-expo",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@babel/runtime": "7.29.7",
    "@expo/ui": "~57.0.9",
    "@livekit/react-native": "^2.12.0",
    "@livekit/react-native-expo-plugin": "^1.0.2",
    "@livekit/react-native-webrtc": "^144.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "~7.11.0",
    "expo": "~57.0.11",
    "expo-application": "~57.0.2",
    "expo-asset": "~57.0.9",
    "expo-audio": "~57.0.3",
    "expo-background-task": "~57.0.8",
    "expo-blur": "~57.0.2",
    "expo-build-properties": "~57.0.9",
    "expo-camera": "~57.0.3",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.9",
    "expo-contacts": "~57.0.3",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.10",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-iap": "^5.0.1",
    "expo-image": "~57.0.2",
    "expo-image-manipulator": "~57.0.8",
    "expo-image-picker": "~57.0.8",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.5",
    "expo-local-authentication": "~57.0.2",
    "expo-localization": "~57.0.1",
    "expo-location": "~57.0.8",
    "expo-media-library": "~57.0.3",
    "expo-network": "~57.0.1",
    "expo-notifications": "~57.0.9",
    "expo-router": "~57.0.11",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.8",
    "expo-splash-screen": "~57.0.5",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-store-review": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "expo-task-manager": "~57.0.8",
    "expo-updates": "~57.0.12",
    "expo-video": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "libphonenumber-js": "^1.13.10",
    "livekit-client": "^2.21.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-google-mobile-ads": "16.4.0",
    "react-native-maps": "1.27.2",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@expo/fingerprint": "0.20.6",
    "@sentry/cli": "2.58.4",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "^26.1.2",
    "@types/react": "~19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^9.39.1",
    "eslint-config-expo": "^57.0.1",
    "expo-doctor": "^1.20.1",
    "jest": "29.7.0",
    "jest-expo": "~57.0.3",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "expo-sharing"
      ]
    }
  },
  "scripts": {
    "start": "expo start --dev-client",
    "start:go": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "validate": "pnpm secrets:scan && pnpm assets:verify && pnpm localization:verify && pnpm lint && pnpm typecheck && pnpm test && pnpm release-policy:test && pnpm fingerprint:generate && pnpm expo:config && pnpm eas:config:verify",
    "expo:config": "expo config --type public",
    "expo:doctor": "expo-doctor",
    "fingerprint:generate": "node ./scripts/generate-fingerprint.mjs",
    "release-policy:test": "node ./scripts/test-eas-release-policy.mjs",
    "secrets:scan": "node ./scripts/scan-secrets.mjs",
    "audit:native": "node ./scripts/generate-native-audit.mjs",
    "audit:api-routes": "node ./scripts/generate-api-route-inventory.mjs",
    "audit:api-contracts": "node ./scripts/generate-api-contract-inventory.mjs",
    "parity:pair": "zsh ./scripts/parity-fixed-pair.sh",
    "parity:pair:status": "zsh ./scripts/parity-fixed-pair.sh status",
    "parity:pair:boot": "zsh ./scripts/parity-fixed-pair.sh boot",
    "parity:pair:shutdown": "zsh ./scripts/parity-fixed-pair.sh shutdown",
    "parity:pair:capture": "zsh ./scripts/parity-fixed-pair.sh capture",
    "parity:serve:frozen": "zsh ./scripts/parity-start-frozen.sh",
    "assets:verify": "node ./scripts/verify-native-assets.mjs",
    "localization:generate": "node ./scripts/localization-catalog.mjs generate",
    "localization:verify": "node ./scripts/localization-catalog.mjs verify",
    "eas:whoami": "pnpm dlx eas-cli@21.6.0 whoami",
    "eas:init": "pnpm dlx eas-cli@21.6.0 init",
    "eas:config:verify": "node ./scripts/verify-eas-config.mjs",
    "channel:list": "pnpm dlx eas-cli@21.6.0 channel:list",
    "update:list": "pnpm dlx eas-cli@21.6.0 update:list",
    "build:development:ios": "pnpm dlx eas-cli@21.6.0 build --profile development --platform ios",
    "build:development:android": "pnpm dlx eas-cli@21.6.0 build --profile development --platform android",
    "build:preview:ios": "pnpm dlx eas-cli@21.6.0 build --profile preview --platform ios",
    "build:preview:ios:simulator": "pnpm dlx eas-cli@21.6.0 build --profile preview-simulator --platform ios",
    "build:preview:android": "pnpm dlx eas-cli@21.6.0 build --profile preview --platform android",
    "build:prod:ios": "pnpm dlx eas-cli@21.6.0 build --profile production --platform ios",
    "build:prod:android": "pnpm dlx eas-cli@21.6.0 build --profile production --platform android",
    "submit:prod:ios": "pnpm dlx eas-cli@21.6.0 submit --profile production --platform ios",
    "submit:prod:android": "pnpm dlx eas-cli@21.6.0 submit --profile production --platform android",
    "update:preview": "node ./scripts/publish-update.mjs preview",
    "update:production": "node ./scripts/publish-update.mjs production",
    "update:preview:dry-run": "node ./scripts/publish-update.mjs preview --dry-run",
    "update:production:dry-run": "node ./scripts/publish-update.mjs production --dry-run",
    "update:rollout": "node ./scripts/manage-update.mjs rollout",
    "update:revert-rollout": "node ./scripts/manage-update.mjs revert-rollout",
    "update:rollback": "node ./scripts/manage-update.mjs rollback"
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/tests",
      "<rootDir>/modules"
    ],
    "setupFiles": [
      "<rootDir>/tests/setup.ts"
    ],
    "testMatch": [
      "<rootDir>/tests/**/*.test.ts",
      "<rootDir>/tests/**/*.test.tsx"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/app/**"
    ]
  },
  "private": true,
  "packageManager": "pnpm@11.16.0"
}
