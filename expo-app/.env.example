# Public EAS project binding. These checked-in defaults can be overridden explicitly.
EAS_PROJECT_ID=f623eda4-1a5f-4227-9890-1a2eb5a6df2c
EXPO_OWNER=wegpt

# development | preview | production
APP_ENV=development

# EXPO_PUBLIC values are bundled into the app and must never contain secrets.
EXPO_PUBLIC_API_BASE_URL=https://id7.com/api/v1
EXPO_PUBLIC_WEB_BASE_URL=https://id7.com
EXPO_PUBLIC_WEBSOCKET_URL=wss://id7.com/ws
EXPO_PUBLIC_REMOTE_CONFIG_URL=https://id7.com/api/v1/app/config
EXPO_PUBLIC_NOTIFICATION_ASSET_BASE_URLS=https://d3rijhu8azna1i.cloudfront.net
EXPO_PUBLIC_SENTRY_DSN=

# AdMob application identifiers compiled into the one-time native build.
EXPO_PUBLIC_IOS_ADMOB_APP_ID=ca-app-pub-1877504503518465~7347579927
EXPO_PUBLIC_ANDROID_ADMOB_APP_ID=ca-app-pub-3940256099942544~3347511713

# Keep these only in EAS/CI secrets, never in this file.
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
# EXPO_TOKEN=
